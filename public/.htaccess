# ---- natanalfaro.org: sitio estático React en BanaHosting (LiteSpeed) ----

RewriteEngine On

# 1. Forzar HTTPS y dominio sin "www"
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://natanalfaro.org%{REQUEST_URI} [L,R=301]

# 2. Rutas del WordPress viejo que ya no existen: responder 410 (Gone)
#    para que Google retire las páginas de spam indexadas.
RewriteRule ^(wp-admin|wp-content|wp-includes|wp-json|xmlrpc\.php|wp-login\.php) - [G,L]
RewriteRule ^(category|tag|author|feed)(/.*)?$ - [G,L]

# 3. Redirecciones 301 de URLs viejas (completar con el inventario del sitemap)
Redirect 301 /ofrenda-y-diezmo/ /ofrenda

# 4. React Router: toda ruta que no sea un archivo real la atiende index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 5. Seguridad: este sitio no ejecuta PHP
<FilesMatch "\.(php|phtml|phar)$">
  Require all denied
</FilesMatch>
Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. Caché: los archivos de /assets llevan hash en el nombre, se pueden cachear 1 año
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
</IfModule>
